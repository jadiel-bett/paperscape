# PaperScape backend direct-development environment template.
#
# Copy this file to backend/.env when running the FastAPI backend directly from
# the backend/ directory. The real backend/.env file is ignored and must never
# be committed. Docker Compose uses the root .env file for interpolation instead.

# Backend-only optional live watsonx.ai configuration. Leave these empty for
# credential-free development; upload/extraction and health still work, while
# research-map generation is unavailable until credentials are configured.
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
# Optional backend model override. If omitted, Settings uses its built-in model.
# GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Direct backend development database. For Docker Compose, the root Compose file
# uses sqlite:////data/paperscape.db with a named volume mounted at /data.
DATABASE_URL=sqlite:///./paperscape.db

# Direct backend development settings.
UPLOAD_MAX_BYTES=20971520
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend note: PAPERSCAPE_API_BASE_URL is a non-secret Flutter build value and
# belongs in root .env for Compose or in flutter build/run --dart-define flags.
# Changing it requires rebuilding the Flutter Web frontend image.
