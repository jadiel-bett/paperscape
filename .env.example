# PaperScape root environment template for Docker Compose interpolation.
#
# Copy this file to .env in the repository root for local Compose runs.
# The real .env file is ignored and must never be committed.
#
# Credential-free Compose startup works with the watsonx values left empty:
# the backend can start, serve health, and extract uploads, while research-map
# generation returns generation_unavailable until backend-only credentials are set.

# Backend-only optional live watsonx.ai configuration. Do not pass these values
# to Flutter and do not put real credentials in committed files.
# Compose uses COMPOSE_* names to avoid accidentally forwarding old placeholder
# WATSONX_* values from a direct-development .env file into containers.
# Docker Compose intentionally reads COMPOSE_WATSONX_API_KEY and
# COMPOSE_WATSONX_PROJECT_ID. Setting WATSONX_API_KEY or WATSONX_PROJECT_ID in
# the repository-root .env does not configure the Compose backend. Direct
# backend development uses the WATSONX_* names documented in backend/.env.example.
COMPOSE_WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
COMPOSE_WATSONX_PROJECT_ID=
# Compose uses the backend application's granite_model_id default and does not
# currently expose a GRANITE_MODEL_ID override. Direct backend development may
# set GRANITE_MODEL_ID as documented in backend/.env.example.

# Docker Compose backend runtime configuration.
# docker-compose.yml sets DATABASE_URL to sqlite:////data/paperscape.db so the
# database lives in the named Docker volume mounted at /data.
UPLOAD_MAX_BYTES=20971520

# Non-secret Flutter Web build value. Browser JavaScript must call localhost
# during local Compose runs; it cannot resolve the Compose hostname "backend".
# Changing this requires rebuilding the frontend image.
PAPERSCAPE_API_BASE_URL=http://localhost:8000/api/v1

# Direct-development examples, not consumed by the Compose file as written:
# DATABASE_URL=sqlite:///./paperscape.db
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080
